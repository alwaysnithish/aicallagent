# Public (safe for the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used only by `npm run migrate` (Supabase -> Connect -> Session pooler URI, password filled in)
SUPABASE_DB_URL=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Phone calls (Twilio): auth token of your Twilio account
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=

# Outbound dialer: any random string of 16+ chars; also used by `npm run dialer` and cron
CRON_SECRET=
# Price charged per started minute of outbound calls, in paise (500 = Rs 5)
OUTBOUND_RATE_PAISE_PER_MIN=500

# Billing (Razorpay). Use rzp_test_ keys while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=
